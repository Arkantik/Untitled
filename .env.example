# Copy to .env and fill in values before running pnpm dev.

# -- Auth (required) --
BETTER_AUTH_SECRET=replace-with-a-long-random-string
BETTER_AUTH_URL=http://localhost:3000

# -- Database --
DB_DIALECT=sqlite
# SQLITE_DB_PATH=./data/pulsarr.db
# DATABASE_URL=postgres://...

# -- Billing (optional) --
BILLING_ENABLED=false
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_PRO_PRICE_ID=price_...
# APP_URL=http://localhost:3000

# -- Infrastructure --
# VALKEY_URL=redis://localhost:6379

# -- Social OAuth --

# X (Twitter) - https://developer.twitter.com/en/portal/dashboard
# Callback URL: {APP_URL}/api/v1/accounts/callback/x
# X_CLIENT_ID=
# X_CLIENT_SECRET=

# LinkedIn - https://www.linkedin.com/developers/apps
# Callback URL: {APP_URL}/api/v1/accounts/callback/linkedin
# LINKEDIN_CLIENT_ID=
# LINKEDIN_CLIENT_SECRET=

# Meta (Facebook + Instagram) - https://developers.facebook.com/apps
# Callback URL: {APP_URL}/api/v1/accounts/callback/facebook
# FACEBOOK_APP_ID=
# FACEBOOK_APP_SECRET=

# Threads - https://developers.facebook.com/apps (separate app from Meta)
# Callback URL: {APP_URL}/api/v1/accounts/callback/threads
# THREADS_APP_ID=
# THREADS_APP_SECRET=