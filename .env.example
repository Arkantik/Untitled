# ──────────────────────────────────────────
# Pulsarr — Environment Variables
# Copy to .env and fill in values
# ──────────────────────────────────────────

# App
NODE_ENV=development
PORT=3001

# Database — "sqlite" (default, zero-config) or "postgresql"
DB_DIALECT=sqlite
SQLITE_DB_PATH=./data/pulsarr.db
# DATABASE_URL=postgresql://pulsarr:pulsarr@localhost:5432/pulsarr

# Valkey / Redis (for self-hosted)
# VALKEY_URL=redis://localhost:6379

# Auth (Better Auth)
BETTER_AUTH_SECRET=change-me-to-a-random-string
BETTER_AUTH_URL=http://localhost:3000

# Social OAuth
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# X_CLIENT_ID=
# X_CLIENT_SECRET=
# LINKEDIN_CLIENT_ID=
# LINKEDIN_CLIENT_SECRET=

# Stripe
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=

# S3-compatible storage (for media uploads)
# S3_ENDPOINT=
# S3_BUCKET=
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# S3_REGION=
